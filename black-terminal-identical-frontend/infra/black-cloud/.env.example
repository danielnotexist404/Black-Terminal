# Non-secret deployment coordinates. Copy to .env on the VPS and keep mode 600.
BLACK_CLOUD_DEPLOYMENT_COMMIT=0000000000000000000000000000000000000000
BLACK_CLOUD_PUBLIC_URL=http://127.0.0.1:18080
BLACK_CLOUD_GATEWAY_BIND=127.0.0.1:18080
BLACK_CLOUD_CADDYFILE=./Caddyfile.staging
BLACK_CLOUD_DOMAIN=black-cloud-staging.invalid
BLACK_CLOUD_TLS_EMAIL=operator@example.invalid
BLACK_CLOUD_CUTOVER_APPROVED=false
BLACK_CLOUD_RUNTIME_ENV_FILE=./secrets/runtime.env
BLACK_CLOUD_SUPABASE_STATE_ROOT=/var/lib/black-cloud/supabase
QALC_DATA_ROOT=/var/lib/black-cloud/qalc
IMM_ENABLED=false
QALC_RESEARCH_ENABLED=false

# The anonymous key is public by design and is embedded into the frontend.
# It must match the self-hosted Auth/PostgREST signing configuration.
ANON_KEY=replace-with-generated-self-hosted-anon-key

# Supabase is pinned by tag and peeled Git commit. prepare-supabase.sh verifies both.
SUPABASE_SELF_HOSTED_TAG=self-hosted/v0.7.2
SUPABASE_SELF_HOSTED_COMMIT=549db119c44c25167461812041ba198bde2b31a4
