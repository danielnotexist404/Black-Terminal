PGPASSWORD=replace-with-self-hosted-postgres-password
RESTIC_REPOSITORY=/repository
RESTIC_PASSWORD=replace-with-long-random-restic-password
BLACK_CLOUD_BACKUP_INTERVAL_SECONDS=21600
BLACK_CLOUD_BACKUP_RETENTION_DAILY=14
BLACK_CLOUD_BACKUP_RETENTION_WEEKLY=8
BLACK_CLOUD_BACKUP_RETENTION_MONTHLY=12

# For off-host S3-compatible backups, replace RESTIC_REPOSITORY and provide:
# RESTIC_REPOSITORY=s3:https://object-storage.example/bucket/black-cloud
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
