NODE_ENV=production
PUBLIC_APP_URL=http://127.0.0.1:18080
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_SERVICE_ROLE_KEY=replace-with-self-hosted-service-role-key
SUPABASE_SECRET_KEY=replace-with-self-hosted-secret-key-if-enabled

# Provider credentials stay server-side. Do not use VITE_* names for secrets.
CLAUDE_API_KEY=
RESEND_API_KEY=
RESEND_FROM=

# Required to preserve Google identities after production cutover. The
# initializer copies these into the private self-hosted Auth environment.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Existing encryption/signing keys must be migrated byte-for-byte or encrypted
# broker material becomes unreadable. Never rotate them during import.
EXCHANGE_CREDENTIAL_MASTER_KEY=
BLACK_CLOUD_SECRET_MASTER_KEY_V1=
BLACK_CLOUD_MASTER_KEY_VERSION=1
BLACK_CLOUD_INTENT_SIGNING_KEY=

# Staging is fail-closed. The live-execution profile must not be started until
# explicit cutover approval and a separate execution-readiness certificate.
CLOUD_EXECUTION_CONTROL_PLANE_ENABLED=false
BLACK_CLOUD_EXECUTION_ENABLED=false
INVESTMENT_GROUP_EXECUTION_ENABLED=false
BYBIT_CLOUD_EXECUTION_ENABLED=false
BLACK_CLOUD_STRATEGY_RUNTIME_ENABLED=false
BLACK_CLOUD_MAINNET_ENABLED=false
BYBIT_PRIVATE_STREAM_RUNTIME_ENABLED=false

# Event Alpha remains paper-only.
EVENT_ALPHA_ENGINE_ENABLED=true
EVENT_ALPHA_PAPER_EXECUTION_ENABLED=false
EVENT_ALPHA_LIVE_EXECUTION_ENABLED=false
EVENT_ALPHA_STRATEGY_KILL_SWITCH=true
EVENT_ALPHA_GLOBAL_EXECUTION_KILL_SWITCH=true

# Future external Institutional Market Map node. Black Cloud remains usable
# while disabled and must never fabricate IMM output.
IMM_ENABLED=false
IMM_REQUIRED=false
IMM_BASE_URL=
IMM_ENDPOINT=
IMM_SHARED_HMAC_KEY=
IMM_PROTOCOL_VERSION=v1
IMM_JOB_TIMEOUT_MS=30000
IMM_MAX_ATTEMPTS=3

# BC-QALC initial service is public-data Research capture only. Paper requires
# a separately certified, account-specific fee binding. Live/group stay false.
QALC_PAPER_ENABLED=false
QALC_LIVE_EXECUTION_ENABLED=false
QALC_GROUP_FANOUT_ENABLED=false
QALC_ALLOW_PAPER_CANDIDATES=false
