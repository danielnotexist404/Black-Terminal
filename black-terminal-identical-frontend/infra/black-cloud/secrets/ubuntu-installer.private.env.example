# Copy this file outside the repository and set mode 600:
#   install -m 600 infra/black-cloud/secrets/ubuntu-installer.private.env.example /root/black-cloud.private.env
# Do not commit the populated copy.

# Production provider services
CLAUDE_API_KEY=
RESEND_API_KEY=
RESEND_FROM=

# Identity continuity (required when moving existing Google-authenticated users)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Supply the existing values when importing an existing Black Terminal database.
# Leave blank only for a genuinely fresh database; the installer then generates them.
EXCHANGE_CREDENTIAL_MASTER_KEY=
BLACK_CLOUD_SECRET_MASTER_KEY_V1=
BLACK_CLOUD_MASTER_KEY_VERSION=1
BLACK_CLOUD_INTENT_SIGNING_KEY=

# Optional external IMM protocol configuration. The built-in market-depth worker
# does not require these values.
IMM_BASE_URL=
IMM_ENDPOINT=
IMM_SHARED_HMAC_KEY=
IMM_PROTOCOL_VERSION=v1

# Production must use an off-host repository. Examples: s3:, sftp:, rest:, rclone:.
# A rclone: repository also requires the installer's --rclone-config option.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Optional monitoring administrator override. A random password is generated if empty.
GF_SECURITY_ADMIN_USER=blackcloud-admin
GF_SECURITY_ADMIN_PASSWORD=
