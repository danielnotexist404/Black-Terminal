SUPABASE_URL=https://project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-value
# REQUIRED — credential envelope keys. Keep every still-active version during rotation.
EXCHANGE_CREDENTIAL_MASTER_KEY=base64-encoded-existing-32-byte-legacy-migration-key
BLACK_CLOUD_SECRET_MASTER_KEY_V1=base64-encoded-32-byte-wrapping-key
BLACK_CLOUD_MASTER_KEY_VERSION=1
BLACK_CLOUD_INTENT_SIGNING_KEY=minimum-32-byte-server-only-signing-key
# REQUIRED — execution gates.
CLOUD_EXECUTION_CONTROL_PLANE_ENABLED=true
BLACK_CLOUD_EXECUTION_ENABLED=true
INVESTMENT_GROUP_EXECUTION_ENABLED=false
BYBIT_CLOUD_EXECUTION_ENABLED=true
# Bybit Demo strategy execution is simulated-funds only. Real-funds strategy
# execution remains structurally disabled by the worker and routing policy.
BLACK_CLOUD_STRATEGY_RUNTIME_ENABLED=true
STRATEGY_AUTOMATION_DEMO_EXECUTION_ENABLED=true
STRATEGY_AUTOMATION_LIVE_EXECUTION_ENABLED=false
STRATEGY_AUTOMATION_LIVE_EXECUTION_CERTIFIED=false
# REQUIRED — deploy separate worker instances for DEMO and MAINNET_LIVE.
BLACK_CLOUD_EXECUTION_ENVIRONMENT=DEMO
BYBIT_ENDPOINT_PROFILE=GLOBAL
# DEMO — required only on the Demo worker.
BYBIT_DEMO_ENABLED=true
# MAINNET_LIVE — required only on the live worker. Never enable by accident.
BLACK_CLOUD_MAINNET_ENABLED=false
# REQUIRED — stable node identity, immutable artifact identity and location.
BLACK_CLOUD_NODE_ID=BLACK_CLOUD_NODE_01
BLACK_CLOUD_WORKER_REGION=provider-region
BLACK_CLOUD_HOSTNAME=redacted-existing-vps
BLACK_CLOUD_DEPLOYMENT_ENVIRONMENT=PRODUCTION
BLACK_CLOUD_DEPLOYMENT_COMMIT=7a75e7c
BLACK_CLOUD_IMAGE_REFERENCE=black-terminal-black-cloud:7a75e7c
BLACK_CLOUD_IMAGE_DIGEST=sha256:replace-with-64-hex-character-local-image-id
BLACK_CLOUD_HEALTH_BIND_ADDRESS=0.0.0.0
BLACK_CLOUD_HEALTH_PORT=8080
BLACK_CLOUD_METRICS_BIND_ADDRESS=0.0.0.0
BLACK_CLOUD_METRICS_PORT=8080
BLACK_CLOUD_LOG_LEVEL=INFO
BLACK_CLOUD_MAX_CLOCK_DRIFT_MS=3000
BLACK_CLOUD_NODE_HEARTBEAT_INTERVAL_MS=10000
# OPTIONAL — queue and lease tuning.
BLACK_CLOUD_POLL_INTERVAL_MS=1000
BLACK_CLOUD_CLAIM_LIMIT=10
BLACK_CLOUD_LEASE_TTL_SECONDS=30
# DEPRECATED/FORBIDDEN — do not set:
# BLACK_CLOUD_NETWORK
# BYBIT_BASE_URL
# BYBIT_PRIVATE_WS_URL
