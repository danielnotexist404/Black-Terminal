# syntax=docker/dockerfile:1.7

FROM node:22.23.1-bookworm-slim AS dependencies
WORKDIR /opt/black-terminal
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

FROM node:22.23.1-bookworm-slim AS build
WORKDIR /opt/black-terminal
ENV NODE_ENV=development
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_CLAUDE_API_KEY=""
ARG VITE_RESEND_API_KEY=""
ARG VITE_RESEND_FROM=""
ENV VITE_SUPABASE_URL=${VITE_SUPABASE_URL}
ENV VITE_SUPABASE_ANON_KEY=${VITE_SUPABASE_ANON_KEY}
ENV VITE_CLAUDE_API_KEY=${VITE_CLAUDE_API_KEY}
ENV VITE_RESEND_API_KEY=${VITE_RESEND_API_KEY}
ENV VITE_RESEND_FROM=${VITE_RESEND_FROM}
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY index.html tsconfig.json vite.config.ts ./
COPY src ./src
COPY api ./api
COPY server ./server
COPY scripts ./scripts
RUN npm run typecheck && npm run security:contracts && npx vite build && npm run security:audit

FROM nginxinc/nginx-unprivileged:1.27.4-alpine AS frontend
COPY infra/black-cloud/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /opt/black-terminal/dist /usr/share/nginx/html
USER 101
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=4 CMD wget -q -O /dev/null http://127.0.0.1:8080/health.html || exit 1

FROM node:22.23.1-bookworm-slim AS runtime
WORKDIR /opt/black-terminal
ENV NODE_ENV=production
RUN groupadd --gid 10001 blackterminal && useradd --uid 10001 --gid blackterminal --no-create-home --shell /usr/sbin/nologin blackterminal
COPY --from=dependencies --chown=blackterminal:blackterminal /opt/black-terminal/node_modules ./node_modules
COPY --chown=blackterminal:blackterminal package.json package-lock.json ./
COPY --chown=blackterminal:blackterminal api ./api
COPY --chown=blackterminal:blackterminal server ./server
COPY --chown=blackterminal:blackterminal scripts ./scripts
COPY --chown=blackterminal:blackterminal src ./src
COPY --chown=blackterminal:blackterminal tsconfig.bclif-collector.json tsconfig.json ./
USER 10001:10001
STOPSIGNAL SIGTERM

FROM runtime AS api
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=4s --start-period=15s --retries=4 CMD node -e "fetch('http://127.0.0.1:3000/health/live').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "server/black-cloud/api-server.js"]

FROM runtime AS worker
CMD ["node", "scripts/event-alpha-worker.js"]
