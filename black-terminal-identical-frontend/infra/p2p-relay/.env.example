# Must resolve publicly and route TCP/4001 to this host.
BT_RELAY_ADVERTISE=/dns4/relay1.example.com/tcp/4001

# Capacity limits. Deploy at least two relays on independent networks instead
# of raising these without monitoring bandwidth and abuse.
BT_RELAY_MAX_RESERVATIONS=256
BT_RELAY_MAX_RESERVATIONS_PER_PEER=2
BT_RELAY_MAX_CIRCUITS=128
BT_RELAY_MAX_CIRCUITS_PER_PEER=4
BT_RELAY_MAX_CIRCUIT_BYTES=8388608
