FROM node:22.23.1-bookworm-slim
ARG BLACK_CLOUD_DEPLOYMENT_COMMIT=unknown
LABEL org.opencontainers.image.title="Black Terminal Black Cloud Worker" \
      org.opencontainers.image.revision="${BLACK_CLOUD_DEPLOYMENT_COMMIT}" \
      org.opencontainers.image.vendor="Black Triangle Group"
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY server ./server
COPY scripts/black-cloud-execution-worker.js ./scripts/black-cloud-execution-worker.js
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD ["node", "-e", "fetch('http://127.0.0.1:8080/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "scripts/black-cloud-execution-worker.js"]
