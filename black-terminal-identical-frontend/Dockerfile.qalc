FROM node:22.23.1-bookworm-slim
ARG BLACK_CLOUD_DEPLOYMENT_COMMIT=unknown
LABEL org.opencontainers.image.title="Black Terminal BC-QALC Worker" \
      org.opencontainers.image.revision="${BLACK_CLOUD_DEPLOYMENT_COMMIT}" \
      org.opencontainers.image.vendor="Black Triangle Group"
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY server/qalc ./server/qalc
COPY scripts/qalc-worker.ts ./scripts/qalc-worker.ts
RUN groupadd --gid 10001 blackterminal && useradd --uid 10001 --gid blackterminal --no-create-home --shell /usr/sbin/nologin blackterminal
RUN chown -R 10001:10001 /app
USER 10001:10001
HEALTHCHECK --interval=15s --timeout=3s --start-period=30s --retries=3 CMD ["node", "-e", "const fs=require('fs');const p=process.env.QALC_STATE_PATH||'/var/lib/black-terminal/qalc/state/current.json';const x=JSON.parse(fs.readFileSync(p));if(Date.now()-x.updatedAt>15000)process.exit(1)"]
CMD ["node", "--experimental-strip-types", "scripts/qalc-worker.ts"]
