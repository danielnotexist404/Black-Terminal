FROM node:22.23.1-bookworm-slim AS production-dependencies

WORKDIR /opt/bclif
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
    && npm cache clean --force

FROM node:22.23.1-bookworm-slim AS runtime

ARG BCLIF_DEPLOYMENT_COMMIT
LABEL org.opencontainers.image.title="Black Core Liquidation Intelligence Collector" \
      org.opencontainers.image.description="Persistent public-market analytics and BCLIF tile collector" \
      org.opencontainers.image.revision="${BCLIF_DEPLOYMENT_COMMIT}" \
      org.opencontainers.image.vendor="Black Triangle Group"

ENV NODE_ENV=production \
    NODE_OPTIONS=--enable-source-maps \
    BCLIF_HEALTH_BIND_ADDRESS=0.0.0.0 \
    BCLIF_HEALTH_PORT=8091 \
    BCLIF_SPOOL_DIRECTORY=/var/lib/bclif-spool

RUN groupadd --system --gid 10001 bclif \
    && useradd --system --uid 10001 --gid bclif --home-dir /nonexistent --shell /usr/sbin/nologin bclif \
    && install -d -o bclif -g bclif -m 0750 /opt/bclif /var/lib/bclif-spool

WORKDIR /opt/bclif
COPY --from=production-dependencies --chown=bclif:bclif /opt/bclif/node_modules ./node_modules
COPY --chown=bclif:bclif package.json ./package.json
COPY --chown=bclif:bclif server/liquidation-intelligence ./server/liquidation-intelligence
COPY --chown=bclif:bclif src/modules/liquidation-field/core ./src/modules/liquidation-field/core
COPY --chown=bclif:bclif scripts/bclif-collector-worker.ts ./scripts/bclif-collector-worker.ts

USER 10001:10001
EXPOSE 8091
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:8091/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]

CMD ["node", "--experimental-strip-types", "scripts/bclif-collector-worker.ts"]
