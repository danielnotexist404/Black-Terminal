# BT-EAE-001 Event Alpha — fail-closed defaults.
# This subsystem is research + PAPER execution only. There is no supported live flag.
EVENT_ALPHA_ENGINE_ENABLED=false
EVENT_ALPHA_INGESTION_ENABLED=false
EVENT_ALPHA_TOKEN_SUPPLY_ENABLED=false
EVENT_ALPHA_GOVERNANCE_ENABLED=false
EVENT_ALPHA_PROTOCOL_ECONOMICS_ENABLED=false
EVENT_ALPHA_LLM_EXTRACTION_ENABLED=false
EVENT_ALPHA_PAPER_EXECUTION_ENABLED=false
EVENT_ALPHA_LIVE_EXECUTION_ENABLED=false
EVENT_ALPHA_REQUIRE_MANUAL_APPROVAL=true
EVENT_ALPHA_STRATEGY_KILL_SWITCH=true
EVENT_ALPHA_GLOBAL_EXECUTION_KILL_SWITCH=true

# Credentialed token-unlock adapter. Leave all three unset to keep it DISABLED.
EVENT_ALPHA_TOKEN_UNLOCK_SOURCE_KEY=TOKEN_UNLOCK_PROVIDER_V1
EVENT_ALPHA_TOKEN_UNLOCK_API_URL=
EVENT_ALPHA_TOKEN_UNLOCK_API_TOKEN=
EVENT_ALPHA_TOKEN_UNLOCK_ALLOWED_HOSTS=
EVENT_ALPHA_SOURCE_TIMEOUT_MS=12000
